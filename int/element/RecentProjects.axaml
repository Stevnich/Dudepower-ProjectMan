<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dpProject"
             x:Class="dpProject.Element.RecentProjectsView">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Margin="30,28,30,18" Spacing="5">
      <TextBlock Text="YOUR WORKSPACE" FontSize="11" FontWeight="SemiBold"
                 LetterSpacing="0.8" Foreground="{DynamicResource MutedForegroundBrush}" />
      <TextBlock Text="Recent projects" FontSize="26" FontWeight="Bold" />
      <TextBlock Text="Pick up where you left off."
                 FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="RecentGrid" Margin="22,0,22,22">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ProjectItem">
            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}" Padding="18,16" Margin="8,5">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Description}" FontSize="12"
                             Foreground="{DynamicResource MutedForegroundBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BrandBrush}" />
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto"
                      Margin="0,14,0,0">
                  <ProgressBar Height="5" Minimum="0" Maximum="100"
                               Value="{Binding Progress}"
                               Background="{DynamicResource MutedBrush}"
                               Foreground="{DynamicResource BrandBrush}"
                               VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Percent, StringFormat={}{0:0}%}"
                             Margin="12,0,0,0" FontSize="12" />
                </Grid>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                           Text="{Binding TasksDone, StringFormat={}{0} tasks complete}"
                           Margin="0,9,0,0" FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
