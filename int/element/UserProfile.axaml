<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="dpProject.Element.UserProfileView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="30,28,30,30" Spacing="22">
      <StackPanel Spacing="5">
        <TextBlock Text="YOUR ACCOUNT" FontSize="11" FontWeight="SemiBold"
                   LetterSpacing="0.8" Foreground="{DynamicResource MutedForegroundBrush}" />
        <TextBlock Text="Profile" FontSize="26" FontWeight="Bold" />
      </StackPanel>

      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}" Padding="24">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
          <Border Width="76" Height="76" CornerRadius="38"
                  Background="{DynamicResource BrandSoftBrush}">
            <TextBlock Text="SN" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrandBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
            <TextBlock Text="Stevnich" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Lead Animator" FontSize="13"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <TextBlock Text="stevnich@projectman.studio" FontSize="12"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}" Padding="18">
          <StackPanel Spacing="6">
            <TextBlock Text="Projects" FontSize="12"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <TextBlock Text="6" FontSize="24" FontWeight="Bold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}" Padding="18">
          <StackPanel Spacing="6">
            <TextBlock Text="Completed tasks" FontSize="12"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <TextBlock Text="32" FontSize="24" FontWeight="Bold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}" Padding="18">
          <StackPanel Spacing="6">
            <TextBlock Text="Team" FontSize="12"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <TextBlock Text="8 members" FontSize="18" FontWeight="Bold" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}" Padding="22">
        <StackPanel Spacing="12">
          <TextBlock Text="Account details" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Role: Lead Animator" FontSize="13" />
          <TextBlock Text="Workspace: ProjectMan Studio" FontSize="13" />
          <TextBlock Text="Member since: 2023" FontSize="13"
                     Foreground="{DynamicResource MutedForegroundBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
