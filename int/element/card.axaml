<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="using:Avalonia.Svg.Skia"
             x:Class="dpProject.Element.ProjectCard"
             x:Name="Root"
             Width="357" Height="340">

  <UserControl.Styles>
    <Style Selector="Border#Card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource RingBrush}" />
    </Style>
    <Style Selector="Button#MoreButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="Card"
          Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource RadiusXl}"
          BoxShadow="0 1 3 0 #14000000"
          ClipToBounds="True">
    <Border.Transitions>
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Border.Transitions>

    <Grid RowDefinitions="196,*">

      <!-- ░░ Cover ░░ -->
      <Grid Grid.Row="0" ClipToBounds="True">
        <Border Background="{DynamicResource MutedBrush}" />
        <Image Source="{Binding #Root.Thumbnail}" Stretch="UniformToFill" />

        <!-- status badge -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource BadgeBackgroundBrush}"
                CornerRadius="0,0,12,0" Padding="14,9">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                     Fill="{Binding #Root.StatusBrush}" />
            <TextBlock Text="{Binding #Root.StatusText}"
                       Foreground="{Binding #Root.StatusBrush}"
                       FontSize="12" FontWeight="SemiBold" LetterSpacing="0.4" />
          </StackPanel>
        </Border>

        <!-- progress ring -->
        <Grid Width="46" Height="46" Margin="12"
              HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Ellipse Fill="{DynamicResource BadgeBackgroundBrush}"
                   Stroke="{DynamicResource MutedBrush}" StrokeThickness="4" />
          <Arc StartAngle="-90" SweepAngle="{Binding #Root.RingSweep}"
               Stroke="{Binding #Root.StatusBrush}" StrokeThickness="4"
               StrokeLineCap="Round" />
          <TextBlock Text="{Binding #Root.Percent, StringFormat={}{0:0}%}"
                     Foreground="{DynamicResource ForegroundBrush}"
                     FontSize="10" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Grid>

      <!-- ░░ Body ░░ -->
      <Grid Grid.Row="1" Margin="18,14,18,12" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding #Root.Title}"
                     Foreground="{DynamicResource CardForegroundBrush}"
                     FontSize="17" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button x:Name="MoreButton" Grid.Column="1" Margin="0,0,-6,0">
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource MutedForegroundBrush}" />
              <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource MutedForegroundBrush}" />
              <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource MutedForegroundBrush}" />
            </StackPanel>
          </Button>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,2,0,0"
                   Text="{Binding #Root.Description}"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis" />

        <!-- progress -->
        <StackPanel Grid.Row="3" Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Progress" FontSize="12"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <TextBlock Grid.Column="1" FontSize="12"
                       Text="{Binding #Root.Progress, StringFormat={}{0:0}%}"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
          </Grid>
          <ProgressBar Minimum="0" Maximum="100"
                       Value="{Binding #Root.Progress}"
                       Height="4" MinHeight="4" CornerRadius="2"
                       Background="{DynamicResource MutedBrush}"
                       Foreground="{Binding #Root.StatusBrush}" />
        </StackPanel>

        <!-- footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0" ColumnDefinitions="Auto,Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <svg:Svg Path="/asset/ico/checklist.svg" Css="{DynamicResource IconCss}"
                     Width="16" Height="16" />
            <TextBlock FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForegroundBrush}">
              <Run Text="{Binding #Root.TasksDone}" /><Run Text=" / " /><Run Text="{Binding #Root.TasksTotal}" />
            </TextBlock>
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" Spacing="7">
            <svg:Svg Path="/asset/ico/Comment.svg" Css="{DynamicResource IconCss}"
                     Width="16" Height="16" />
            <TextBlock Text="{Binding #Root.Comments}" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
          </StackPanel>

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7">
            <svg:Svg Path="/asset/ico/calendar.svg" Css="{DynamicResource IconCss}"
                     Width="16" Height="16" />
            <TextBlock Text="{Binding #Root.DueDate}" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
